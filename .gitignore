# ==============================
# EasyImages2.0 .gitignore
# ==============================


# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-*
.project
.classpath
.settings/

# ---- OS 生成文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- AI 工具链元数据 ----
.codeartsdoer/

# ---- 依赖（虽然当前本地引入，预留） ----
vendor/
node_modules/

# ---- 构建产物 ----
*.phar

AGENTS.md
.codegraph/

# ---- 图床运行时产物（存储目录内，不入库） ----
i/cache/
i/recycle/
i/2*/

# ---- 运行时锁文件（部署产物，不入库） ----
config/install.lock
config/EasyIamge.lock

# ---- 审计报告（含部署安全细节，默认不入库） ----
AUDIT_REPORT.md
FIX_RECORD.md

# ---- 后台运行时日志（登录日志、上传日志、IP 计数、统计缓存，含敏感信息，不入库） ----
admin/logs/
